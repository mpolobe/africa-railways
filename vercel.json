{
  "version": 2,
  "buildCommand": "node scripts/generate-config.cjs",
  "cleanUrls": true,
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "memory": 512,
      "maxDuration": 60
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/auth/callback.html"
    },
    {
      "source": "/occ",
      "destination": "/occ.html"
    },
    {
      "source": "/investor",
      "destination": "/investor.html"
    },
    {
      "source": "/invest",
      "destination": "/invest.html"
    },
    {
      "source": "/pitch-deck",
      "destination": "/pitch-deck.html"
    },
    {
      "source": "/vesting",
      "destination": "/investor-vesting-dashboard.html"
    }
  ]
}
