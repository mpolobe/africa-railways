{
  "version": 2,
  "buildCommand": "node scripts/generate-config.js",
  "cleanUrls": true,
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/backup/database",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/auth/callback.html"
    },
    {
      "source": "/occ",
      "destination": "/occ.html"
    },
    {
      "source": "/investor",
      "destination": "/investor.html"
    },
    {
      "source": "/invest",
      "destination": "/invest.html"
    },
    {
      "source": "/pitch-deck",
      "destination": "/pitch-deck.html"
    },
    {
      "source": "/vesting",
      "destination": "/investor-vesting-dashboard.html"
    }
  ]
}
