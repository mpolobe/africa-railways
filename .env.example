# ============================================================================
# AFRICA RAILWAYS - ENVIRONMENT CONFIGURATION
# ============================================================================
# SECURITY NOTICE:
# - NEVER commit actual credentials to version control
# - Use strong, unique values for all secrets
# - Rotate sensitive keys regularly (especially in production)
# - Keep this file in .gitignore on all machines
# - Use environment variable managers (Vercel, GitHub Secrets, etc.)
# ============================================================================

# ============================================================================
# CORE CONFIGURATION
# ============================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Use strong passwords (min 32 chars with mixed case, numbers, symbols)
# For production: use managed database services (Supabase, RDS, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/africa_railways

# ============================================================================
# WEBHOOK SECURITY
# ============================================================================
# These are critical for payment processing security
# Generate using: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PAYMENT_SECRET_HASH=your_flutterwave_secret_hash_here
FLW_SECRET_HASH=your_alternative_secret_here
MTN_MOMO_API_KEY=your_mtn_api_key_here
AIRTEL_CLIENT_SECRET=your_airtel_secret_here

# ============================================================================
# SMS PROVIDER CONFIGURATION
# ============================================================================
SMS_PROVIDER=africas_talking
VITE_AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
VITE_AFRICAS_TALKING_USERNAME=your_africas_talking_username
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username

# Twilio Configuration (alternative SMS provider)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================================
# Generate strong admin key: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_KEY=your_secret_admin_key_here
ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com
CONFIG_DIR=/tmp/telegram-bot

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Generate using: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=your_session_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# ============================================================================
# PAYMENT CONFIGURATION - STRIPE
# ============================================================================
# Get credentials from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# ============================================================================
# SUPABASE CONFIGURATION (Production OAuth)
# ============================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain

# ============================================================================
# AI/LLM CONFIGURATION
# ============================================================================
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# ============================================================================
# BLOCKCHAIN CONFIGURATION - SUI
# ============================================================================
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
SUI_ADMIN_ADDRESS=your_sui_address_here

# ============================================================================
# AIRTABLE CONFIGURATION
# ============================================================================
AIRTABLE_TOKEN=your_airtable_token
AIRTABLE_INFRASTRUCTURE_BASE_ID=your_infrastructure_base_id
AIRTABLE_OPERATIONS_BASE_ID=your_operations_base_id
AIRTABLE_SENTINEL_BASE_ID=your_sentinel_base_id
AIRTABLE_FINANCIAL_BASE_ID=your_financial_base_id

# ============================================================================
# BUILD & DEPLOYMENT
# ============================================================================
EXPO_TOKEN=your_expo_token_here
VERCEL_URL=https://yourdomain.vercel.app

# ============================================================================
# LEGACY / BACKWARD COMPATIBILITY
# ============================================================================
DIGITS_CLIENT_ID=your_id_here
DIGITS_SECRET=your_secret_here
RAILWAYS_API_KEY=your_railways_api_key_here
AFRICOIN_API_KEY=your_africoin_api_key_here
RAILWAYS_API_URL=https://africa-railways.vercel.app
AFRICOIN_API_URL=https://africoin-wallet.vercel.app

